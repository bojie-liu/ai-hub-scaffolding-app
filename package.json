{
  "name": "react-project",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run db:generate; npm run db:migrate; next dev",
    "build": "export NODE_ENV=production && next build",
    "start": "export NODE_ENV=production && npm run db:generate && npm run db:migrate && next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "npx tsx src/db/seed.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.0",
    "@tailwindcss/postcss": "^4",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.31.5",
    "drizzle-orm": "^0.44.6",
    "lucide-react": "^1.8.0",
    "next": "16.1.6",
    "next-themes": "^0.4.6",
    "pg": "^8.13.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "shadcn": "^4.2.0",
    "sonner": "^2.0.7",
    "styled-jsx": "^5.1.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.13.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "typescript": "^5"
  }
}
